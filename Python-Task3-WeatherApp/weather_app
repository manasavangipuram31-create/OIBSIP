"""
Weather App
Oasis Infobyte - Python Programming Internship

Fetches current weather for a city entered by the user, using the free
Open-Meteo API (geocoding + forecast). No API key required.
"""

import requests

GEOCODE_URL = "https://geocoding-api.open-meteo.com/v1/search"
WEATHER_URL = "https://api.open-meteo.com/v1/forecast"

# WMO weather interpretation codes -> human-readable description
WEATHER_CODES = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Depositing rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",
    71: "Slight snow fall",
    73: "Moderate snow fall",
    75: "Heavy snow fall",
    80: "Slight rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",
    95: "Thunderstorm",
    96: "Thunderstorm with slight hail",
    99: "Thunderstorm with heavy hail",
}


def get_coordinates(city_name):
    """
    Look up latitude/longitude and location details for a city name.

    Returns:
        dict with keys: name, country, latitude, longitude
        None if the city could not be found.
    """
    params = {"name": city_name, "count": 1}
    response = requests.get(GEOCODE_URL, params=params, timeout=10)
    response.raise_for_status()
    data = response.json()

    results = data.get("results")
    if not results:
        return None

    top = results[0]
    return {
        "name": top["name"],
        "country": top.get("country", ""),
        "latitude": top["latitude"],
        "longitude": top["longitude"],
    }


def get_current_weather(latitude, longitude):
    """
    Fetch current weather conditions for the given coordinates.

    Returns:
        dict with temperature (C), wind speed (km/h), and a
        human-readable weather description.
    """
    params = {
        "latitude": latitude,
        "longitude": longitude,
        "current_weather": True,
    }
    response = requests.get(WEATHER_URL, params=params, timeout=10)
    response.raise_for_status()
    data = response.json()

    current = data["current_weather"]
    code = current["weathercode"]
    description = WEATHER_CODES.get(code, "Unknown conditions")

    return {
        "temperature_c": current["temperature"],
        "windspeed_kmh": current["windspeed"],
        "description": description,
    }


def main():
    print("=" * 45)
    print("             WEATHER APP")
    print("=" * 45)

    while True:
        city = input("\nEnter a city name (or 'quit' to exit): ").strip()
        if city.lower() == "quit":
            print("Goodbye!")
            break
        if not city:
            print("Please enter a city name.")
            continue

        try:
            location = get_coordinates(city)
            if location is None:
                print(f"Could not find a city named '{city}'. Try again.")
                continue

            weather = get_current_weather(
                location["latitude"], location["longitude"]
            )

            print(f"\nWeather in {location['name']}, {location['country']}:")
            print(f"  Condition:    {weather['description']}")
            print(f"  Temperature:  {weather['temperature_c']} °C")
            print(f"  Wind speed:   {weather['windspeed_kmh']} km/h")

        except requests.exceptions.RequestException as e:
            print(f"Network error while fetching weather data: {e}")
        except (KeyError, IndexError) as e:
            print(f"Unexpected response format: {e}")


if __name__ == "__main__":
    main()
